<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.juan.buscachinos.MainActivity">

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapViewProducts"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:weightSum="1"
        android:id="@+id/linearLayout">

        <Button
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/tag_button"
            android:layout_width="106dp"
            android:layout_height="wrap_content"
            android:text="Taguea el chino"
            android:layout_alignParentStart="true"/>

        <EditText
            app:layout_constraintRight_toLeftOf="@+id/delete_marker"
            app:layout_constraintLeft_toRightOf="@+id/tag_button"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/tag_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />

        <Button
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:id="@+id/delete_marker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/linearLayout"
            android:layout_alignParentStart="true"
            android:text="Borrar chino" />
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
